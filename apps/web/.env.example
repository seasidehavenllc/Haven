NEXT_PUBLIC_API_URL=http://localhost:4000
# Sign in with Google: the web OAuth client id (also listed in the API's GOOGLE_OAUTH_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Sign in with Apple: the Services ID (also listed in the API's APPLE_CLIENT_ID) and a return URL
# registered for it in the Apple developer portal, e.g. https://haven.example.com/login
NEXT_PUBLIC_APPLE_SERVICES_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
