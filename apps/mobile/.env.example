# Base URL of the API. On a phone, use your computer's LAN IP (not localhost), e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Sign in with Google: one OAuth client id per platform (all also listed in the API's GOOGLE_OAUTH_CLIENT_ID).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
