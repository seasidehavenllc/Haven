{
  "expo": {
    "name": "Haven",
    "slug": "haven",
    "owner": "skoobydoobees-team",
    "scheme": "haven",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.seasidehaven.haven",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of items to create listings.",
        "NSPhotoLibraryUsageDescription": "Choose photos of items to create listings.",
        "NSMicrophoneUsageDescription": "Record sound with your videos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.seasidehaven.haven",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1a2f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#149ab8"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of items to create listings.",
          "photosPermission": "Choose photos of items to create listings.",
          "microphonePermission": "Record sound with your videos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#03060a"
        }
      ],
      "expo-video",
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "21477736-dc27-483c-9e87-d82b7c53730c"
      }
    }
  }
}
