# ── Core ──
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce
REDIS_URL=redis://localhost:6379
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Where uploaded media goes. "local" for dev; "s3" for any S3-compatible bucket (Cloudflare R2 is free up to 10 GB).
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto, CDN_BASE_URL = the bucket's public URL.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
# Optional: path to ffprobe so the server measures uploaded videos itself (and rejects unreadable files).
FFPROBE_PATH=

# ── AI providers (platform-owned; never exposed to sellers/buyers) ──
# AI_PROVIDER pins scan-to-sell, listings, the shopping assistant, the co-host and AI salespeople to one
# provider: gemini (free tier, reads photos) | groq (free tier, chat) | anthropic | openai. Leave it empty to
# follow the routing in Admin → AI providers. AI_MODEL optionally overrides the model id for that provider.
AI_PROVIDER=
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# ── Live video ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Payments (Stripe Connect + Billing) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Dev only: allow the clearly-labelled "test" payment provider when Stripe is not configured.
ALLOW_TEST_PAYMENTS=false

# ── Shipping ──
# Labels are bought on the platform's account and charged back to the seller's ledger. Set one (or both, then pick with SHIPPING_PROVIDER).
SHIPPO_API_KEY=
EASYPOST_API_KEY=
SHIPPING_PROVIDER=
# Secret in the tracking webhook URL: https://<api>/webhooks/shipping/shippo?token=<this> (or /easypost). `openssl rand -hex 24`
SHIPPING_WEBHOOK_TOKEN=

# ── Product data (barcode lookup) ──
UPCITEMDB_USER_KEY=

# ── Social sign-in / push / email ──
# Sign in with Apple: comma-separated ids allowed as the token audience, i.e. the iOS bundle id
# (com.seasidehaven.haven) and the web Services ID.
APPLE_CLIENT_ID=
# Sign in with Google: comma-separated OAuth client ids (web, iOS, Android).
GOOGLE_OAUTH_CLIENT_ID=
# Push goes through Expo's push service. The token is only needed if "enhanced push security" is on in your Expo project.
EXPO_ACCESS_TOKEN=
# Email (Resend). Both are needed; EMAIL_FROM must be on a domain verified in Resend, e.g. "Haven <hello@seasidehavenllc.com>".
RESEND_API_KEY=
EMAIL_FROM=
