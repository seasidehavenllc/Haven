// Haven data model. Money = integer cents. Ledgers are append-only.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Accounts ─────────────────────────

enum Role {
  BUYER
  SELLER
  CREATOR
  ADMIN
}

/// Admin panel access. Null means not staff. See packages/shared/src/staff.ts for what each role can do.
enum StaffRole {
  OWNER
  MANAGER
  SUPPORT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  /// The person deleted their account. Personal details are erased; orders and ledgers stay for the records.
  DELETED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  handle       String        @unique
  displayName  String
  avatarUrl    String?
  bio          String?
  roles        Role[]        @default([BUYER])
  staffRole    StaffRole?
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  sessions               Session[]
  oauthAccounts          OAuthAccount[]
  seller                 SellerAccount?
  staffOf                SellerStaff[]
  addresses              Address[]
  cart                   Cart?
  orders                 Order[]
  reviews                Review[]
  bids                   AuctionBid[]
  chatMessages           StreamChatMessage[]
  following              Follow[]                @relation("follower")
  followers              Follow[]                @relation("followee")
  wishlist               WishlistItem[]
  notifications          Notification[]
  pushDevices            PushDevice[]
  notificationPreference NotificationPreference?
  videos                 Video[]
  videoLikes             VideoLike[]
  videoComments          VideoComment[]
  affiliate              Affiliate?
  reportsFiled           Report[]                @relation("reporter")
  auditLogs              AuditLog[]
  sentMessages           DirectMessage[]         @relation("sender")
  recvMessages           DirectMessage[]         @relation("recipient")
  blocking               UserBlock[]             @relation("blocker")
  blockedBy              UserBlock[]             @relation("blocked")
  sellerApplication      SellerApplication?      @relation("applicant")
  reviewedApplications   SellerApplication[]     @relation("reviewer")
}

/// A person blocked another. Neither sees the other's videos, comments or chat, and they can't interact.
model UserBlock {
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model OAuthAccount {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String // apple | google
  providerId String

  @@unique([provider, providerId])
}

enum SellerStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model SellerAccount {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  status          SellerStatus @default(APPROVED)
  stripeAccountId String?      @unique
  payoutsEnabled  Boolean      @default(false)
  aiDisabled      Boolean      @default(false) // merchant-level AI kill switch
  createdAt       DateTime     @default(now())

  storefront       Storefront?
  products         Product[]
  staff            SellerStaff[]
  streams          Livestream[]
  aiAgents         AiAgent[]
  scans            ProductScan[]
  subscription     SellerSubscription?
  creditTxns       AiCreditTransaction[]
  usageRecords     AiUsageRecord[]
  spendingLimit    AiSpendingLimit?
  orders           Order[]
  auctions         Auction[]
  campaigns        AffiliateCampaign[]
  payouts          Payout[]
  aiBillingCharges AiBillingCharge[]
  shippingProfile  SellerShippingProfile?
  ledger           SellerLedgerEntry[]
}

enum SellerApplicationStatus {
  /// Started but not sent: the applicant is still filling it in or setting up payouts.
  DRAFT
  /// Sent and waiting in the admin queue.
  SUBMITTED
  /// Staff asked the applicant for more information. They edit and send it again.
  NEEDS_INFO
  APPROVED
  REJECTED
}

enum SellerBusinessType {
  INDIVIDUAL
  BUSINESS
}

/**
 * A person's request to sell on Haven. Anyone can shop; selling and going live need an approved
 * application. Approving it creates the SellerAccount (status APPROVED) and the storefront.
 * Identity and tax numbers (SSN, EIN) are collected by Stripe during payout setup, never stored here.
 */
model SellerApplication {
  id     String                  @id @default(cuid())
  userId String                  @unique
  user   User                    @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  status SellerApplicationStatus @default(DRAFT)

  // Identity and contact
  legalName   String
  phone       String
  dateOfBirth DateTime?
  /// { line1, line2?, city, region, postalCode, country }
  address     Json

  // Business and tax
  businessType SellerBusinessType @default(INDIVIDUAL)
  businessName String
  /// Requested store address, e.g. "sunny-thrift". Reserved only once approved.
  storeSlug    String
  storeName    String

  // What they sell
  categories      String[]
  description     String
  /// e.g. "1-25", "26-100", "100+"
  inventorySize   String?
  experience      String?
  socialLinks     String[]
  sampleImageUrls String[]

  // Seller terms
  termsVersion    String?
  termsAcceptedAt DateTime?

  // Payouts (Stripe Connect Express)
  stripeAccountId    String? @unique
  payoutsDetailsDone Boolean @default(false)
  payoutsEnabled     Boolean @default(false)

  // Review
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewerId   String?
  reviewer     User?     @relation("reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  /// Reason for a rejection, or the question when staff ask for more information. The applicant sees it.
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, submittedAt])
}

model SellerStaff {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] // products:write, streams:host, orders:fulfill ...

  @@unique([sellerId, userId])
}

model Storefront {
  id             String        @id @default(cuid())
  sellerId       String        @unique
  seller         SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  slug           String        @unique
  name           String
  description    String?
  logoUrl        String?
  bannerUrl      String?
  shippingPolicy String?
  returnPolicy   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String
  isDefault  Boolean @default(false)
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  parentId String?
  parent   Category?  @relation("tree", fields: [parentId], references: [id])
  children Category[] @relation("tree")
  products Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  REMOVED // by moderation
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
  REFURBISHED
}

model Product {
  id                  String           @id @default(cuid())
  sellerId            String
  seller              SellerAccount    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            Category?        @relation(fields: [categoryId], references: [id])
  title               String
  description         String           @default("")
  brand               String?
  model               String?
  condition           ProductCondition @default(NEW)
  tags                String[]
  status              ProductStatus    @default(ACTIVE)
  shippingWeightGrams Int?
  /// When true the product is offered in the seller's live product menu automatically.
  liveMenuEnabled     Boolean          @default(true)
  sourceScanId        String?          @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  variants       ProductVariant[]
  media          ProductMedia[]
  reviews        Review[]
  streamProducts StreamProduct[]
  auctions       Auction[]
  wishlistedBy   WishlistItem[]
  videoTags      VideoProduct[]
  sourceScan     ProductScan?     @relation(fields: [sourceScanId], references: [id])

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([createdAt])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  name       String
  options    Json     @default("{}")
  priceCents Int
  /// On-hand stock. Only changed inside transactions with a guarded UPDATE (quantity >= n).
  quantity   Int      @default(0)
  version    Int      @default(0)
  createdAt  DateTime @default(now())

  cartItems       CartItem[]
  orderItems      OrderItem[]
  inventoryEvents InventoryEvent[]

  @@index([productId])
}

model InventoryEvent {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String // SALE | RESTOCK | ADJUST | CANCEL_RESTORE | AUCTION_WIN
  refId     String?
  createdAt DateTime       @default(now())

  @@index([variantId, createdAt])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  kind      String  @default("image") // image | video
  position  Int     @default(0)
}

model Review {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId String    @unique // verified-purchase only
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  rating      Int
  body        String
  createdAt   DateTime  @default(now())

  @@index([productId])
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

// ───────────────────────── AI product scanner ─────────────────────────

enum ScanStatus {
  UPLOADED
  ANALYZING
  READY // draft available for seller review
  FAILED
  PUBLISHED
  DISCARDED
}

model ProductScan {
  id        String        @id @default(cuid())
  sellerId  String
  seller    SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  batchId   String?
  imageUrls String[]
  barcode   String?
  status    ScanStatus    @default(UPLOADED)
  error     String?
  /// Raw structured AI output (identification + confidence per field).
  result    Json?
  /// Editable listing draft derived from result; seller edits this.
  draft     Json?
  imageHash String? // for duplicate detection within a seller
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  product   Product?

  @@index([sellerId, status])
  @@index([sellerId, imageHash])
  @@index([batchId])
}

// ───────────────────────── Cart & orders ─────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, variantId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

/// One order per seller per checkout ("checkout group" ties them together).
model Order {
  id               String        @id @default(cuid())
  checkoutGroupId  String
  buyerId          String
  buyer            User          @relation(fields: [buyerId], references: [id])
  sellerId         String
  seller           SellerAccount @relation(fields: [sellerId], references: [id])
  status           OrderStatus   @default(PENDING_PAYMENT)
  subtotalCents    Int
  shippingCents    Int           @default(0)
  platformFeeCents Int
  totalCents       Int
  currency         String        @default("USD")
  shippingAddress  Json
  streamId         String?
  affiliateCode    String?
  isTest           Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items      OrderItem[]
  shipments  Shipment[]
  refunds    Refund[]
  commission Commission[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([checkoutGroupId])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  titleSnapshot  String
  unitPriceCents Int
  quantity       Int
  review         Review?
}

model CheckoutSession {
  id             String   @id @default(cuid())
  buyerId        String
  idempotencyKey String
  provider       String // stripe | test
  providerRef    String?
  amountCents    Int
  status         String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | EXPIRED
  isTest         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([buyerId, idempotencyKey])
}

model Payment {
  id          String   @id @default(cuid())
  checkoutId  String   @unique
  provider    String
  providerRef String   @unique
  amountCents Int
  status      String
  isTest      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Refund {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  amountCents Int
  reason      String?
  status      String   @default("REQUESTED")
  providerRef String?
  createdAt   DateTime @default(now())
}

model Payout {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerAccount @relation(fields: [sellerId], references: [id])
  amountCents Int
  status      String
  providerRef String?
  createdAt   DateTime      @default(now())
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id])
  carrier        String?
  service        String?
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  provider       String? // shippo | easypost | manual
  /// The provider's id for the label (Shippo transaction / EasyPost shipment).
  providerRef    String?
  /// What the label cost the platform, charged back to the seller in SellerLedgerEntry.
  labelCostCents Int?
  /// LABEL_CREATED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | RETURNED | FAILURE | UNKNOWN
  status         String          @default("PENDING")
  estDeliveryAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         ShipmentEvent[]

  @@index([trackingNumber])
  @@index([orderId])
}

/// Tracking history as reported by the carrier, via provider webhooks. Append-only.
model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  description String?
  location    String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([shipmentId, status, occurredAt])
}

/// Rates a seller fetched for an order. Buying a label must use a rate from a quote for that order.
model ShippingQuote {
  id          String    @id @default(cuid())
  orderId     String
  provider    String
  /// Provider shipment id the rates belong to.
  shipmentRef String
  rates       Json
  parcel      Json
  /// Set when a label is bought from this quote, so a quote can only be used once.
  purchasedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([orderId])
}

/// How a seller charges buyers for shipping, and where they ship from.
model SellerShippingProfile {
  sellerId               String        @id
  seller                 SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  /// Charged once per order.
  flatRateCents          Int           @default(0)
  /// Added for each item after the first.
  perAdditionalItemCents Int           @default(0)
  /// Orders whose subtotal reaches this ship free. Null means never free.
  freeOverCents          Int?
  handlingDays           Int           @default(2)
  fromName               String?
  fromCompany            String?
  fromLine1              String?
  fromLine2              String?
  fromCity               String?
  fromRegion             String?
  fromPostalCode         String?
  fromCountry            String?       @default("US")
  fromPhone              String?
  /// Default box when a seller doesn't enter one, in inches.
  parcelLengthIn         Float         @default(10)
  parcelWidthIn          Float         @default(8)
  parcelHeightIn         Float         @default(4)
  updatedAt              DateTime      @updatedAt
}

/// Append-only money ledger between the platform and a seller, outside of order proceeds
/// (shipping labels the platform bought for the seller, adjustments). Netted against payouts.
model SellerLedgerEntry {
  id             String        @id @default(cuid())
  sellerId       String
  seller         SellerAccount @relation(fields: [sellerId], references: [id])
  /// Negative: the seller owes the platform. Positive: the platform owes the seller.
  amountCents    Int
  kind           String // LABEL_PURCHASE | LABEL_REFUND | ADJUSTMENT
  refId          String?
  memo           String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  @@index([sellerId, createdAt])
}

// ───────────────────────── Livestreams ─────────────────────────

enum StreamMode {
  HUMAN
  AI_HOST
  HUMAN_AI_COHOST
}

enum CohostMode {
  SILENT
  INVITED
  AUTO_ASSIST
  TAKEOVER
}

enum StreamStatus {
  SCHEDULED
  LIVE
  PAUSED
  ENDED
}

model Livestream {
  id              String        @id @default(cuid())
  sellerId        String
  seller          SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  mode            StreamMode
  cohostMode      CohostMode    @default(SILENT)
  aiPublicSpeech  Boolean       @default(false) // AI may speak/post publicly
  aiPaused        Boolean       @default(false)
  status          StreamStatus  @default(SCHEDULED)
  scheduledFor    DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  videoProvider   String?
  videoRoom       String?       @unique
  aiAgentId       String?
  aiAgent         AiAgent?      @relation(fields: [aiAgentId], references: [id])
  pinnedProductId String?
  createdAt       DateTime      @default(now())

  products StreamProduct[]
  chat     StreamChatMessage[]
  auctions Auction[]
  aiEvents AiTranscriptEntry[]

  @@index([status, scheduledFor])
  @@index([sellerId])
}

model StreamProduct {
  id        String     @id @default(cuid())
  streamId  String
  stream    Livestream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int        @default(0)
  hidden    Boolean    @default(false)

  @@unique([streamId, productId])
}

model StreamChatMessage {
  id        String     @id @default(cuid())
  streamId  String
  stream    Livestream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  body      String
  isAi      Boolean    @default(false) // always disclosed in UI
  /// Spoken version of an AI message (text to speech), played to viewers who have sound on.
  audioUrl  String?
  hidden    Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([streamId, createdAt])
}

// ───────────────────────── AI agents ─────────────────────────

model AiAgent {
  id             String        @id @default(cuid())
  sellerId       String
  seller         SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name           String
  personality    String        @default("friendly")
  salesStyle     String        @default("consultative")
  language       String        @default("en")
  voiceProvider  String?
  voiceId        String?
  avatarProvider String?
  avatarId       String?
  talkingPoints  String[]
  faqs           Json          @default("[]")
  /// Explicit allow-list of actions. Price/refund/discount changes are never permitted.
  permissions    String[]      @default(["answer_questions", "present_products"])
  createdAt      DateTime      @default(now())

  streams Livestream[]
}

model AiTranscriptEntry {
  id        String     @id @default(cuid())
  streamId  String
  stream    Livestream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  speaker   String // host | ai | viewer
  kind      String // transcript | suggestion | public_response | action
  body      String
  meta      Json?
  createdAt DateTime   @default(now())

  @@index([streamId, createdAt])
}

// ───────────────────────── Auctions ─────────────────────────

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model Auction {
  id                 String        @id @default(cuid())
  sellerId           String
  seller             SellerAccount @relation(fields: [sellerId], references: [id])
  productId          String
  product            Product       @relation(fields: [productId], references: [id])
  streamId           String?
  stream             Livestream?   @relation(fields: [streamId], references: [id])
  startingPriceCents Int
  minIncrementCents  Int
  reservePriceCents  Int?
  currentPriceCents  Int?
  leadingBidId       String?       @unique
  leadingBid         AuctionBid?   @relation("leading", fields: [leadingBidId], references: [id])
  startsAt           DateTime
  endsAt             DateTime
  status             AuctionStatus @default(SCHEDULED)
  winnerId           String?
  reserveMet         Boolean?
  version            Int           @default(0)
  createdAt          DateTime      @default(now())

  bids AuctionBid[] @relation("bids")

  @@index([status, endsAt])
}

model AuctionBid {
  id             String   @id @default(cuid())
  auctionId      String
  auction        Auction  @relation("bids", fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId       String
  bidder         User     @relation(fields: [bidderId], references: [id])
  amountCents    Int
  idempotencyKey String
  createdAt      DateTime @default(now())
  leadingFor     Auction? @relation("leading")

  @@unique([bidderId, idempotencyKey])
  @@index([auctionId, amountCents])
}

// ───────────────────────── AI platform: providers, routing, billing ─────────────────────────

model AiProvider {
  id                      String   @id @default(cuid())
  key                     String   @unique // openai | anthropic | google | deepgram | elevenlabs | heygen ...
  name                    String
  adapter                 String // adapter implementation id in code
  enabled                 Boolean  @default(false)
  /// Name of the environment variable holding the secret. The secret itself is never stored in the DB.
  credentialEnvVar        String
  monthlySpendLimitMicros BigInt?
  createdAt               DateTime @default(now())

  models AiProviderModel[]
}

model AiProviderModel {
  id                      String     @id @default(cuid())
  providerId              String
  provider                AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId                 String
  capability              String // AiCapability
  tier                    String     @default("standard") // economy | standard | premium
  enabled                 Boolean    @default(true)
  /// Provider list price in micro-dollars per unit. Units depend on capability.
  inputCostMicrosPerMTok  Int        @default(0)
  outputCostMicrosPerMTok Int        @default(0)
  unitCostMicros          Int        @default(0) // per image / per audio minute / per 1k chars / per video minute
  unitName                String?

  @@unique([providerId, modelId, capability])
}

/// Routing: for a feature, try candidates in priority order (lower first), filtered by plan tier.
model AiRoutingRule {
  id          String  @id @default(cuid())
  feature     String // AiFeature
  modelRefId  String // AiProviderModel.id
  priority    Int     @default(100)
  minPlanTier Int     @default(0)
  enabled     Boolean @default(true)

  @@index([feature, priority])
}

/// Platform-wide controls (single row id = "global").
model PlatformSettings {
  id                      String   @id
  aiEmergencyDisabled     Boolean  @default(false)
  aiDailyBudgetMicros     BigInt?
  aiMonthlyBudgetMicros   BigInt?
  marketplaceFeeBps       Int      @default(800) // 8.00%
  /// Largest refund (per order, in cents) each staff role can give. Owners have no limit.
  managerRefundLimitCents Int      @default(50000)
  supportRefundLimitCents Int      @default(10000)
  allowTestPayments       Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

model AiPlan {
  id                 String   @id @default(cuid())
  key                String   @unique // starter | pro | business | enterprise
  name               String
  tier               Int // 0..3, used by routing + feature gates
  monthlyPriceCents  Int
  annualPriceCents   Int?
  monthlyCredits     Int // credits granted each period
  rolloverPercent    Int      @default(0) // 0..100 of unused allowance carried over
  features           String[] // AiFeature allowed
  limits             Json     @default("{}") // e.g. {"AI_HOST_MINUTE": {"perStreamMax": 60}}
  active             Boolean  @default(true)
  stripePriceMonthly String?
  stripePriceAnnual  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subscriptions SellerSubscription[]
}

/// What each feature costs in credits. Admin-configurable.
model AiFeaturePrice {
  feature        String @id
  creditsPerUnit Int
  unitName       String
}

model SellerSubscription {
  id                   String        @id @default(cuid())
  sellerId             String        @unique
  seller               SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  planId               String
  plan                 AiPlan        @relation(fields: [planId], references: [id])
  interval             String        @default("month")
  status               String        @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean       @default(false)
  stripeSubscriptionId String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

enum CreditTxnKind {
  ALLOWANCE_GRANT
  ALLOWANCE_EXPIRE
  PURCHASE
  USAGE
  REFUND
  ADJUSTMENT
}

/// Append-only credit ledger. Balance = SUM(amount). Never UPDATE rows.
model AiCreditTransaction {
  id             String         @id @default(cuid())
  sellerId       String
  seller         SellerAccount  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  kind           CreditTxnKind
  /// Positive = credit added, negative = consumed.
  amount         Int
  /// allowance credits expire at period end; purchased credits do not
  bucket         String         @default("purchased") // allowance | purchased
  idempotencyKey String         @unique
  usageRecordId  String?
  usageRecord    AiUsageRecord? @relation(fields: [usageRecordId], references: [id])
  revenueCents   Int            @default(0) // money actually received (purchases)
  note           String?
  createdAt      DateTime       @default(now())

  @@index([sellerId, createdAt])
  @@index([usageRecordId])
}

/// Money actually collected for AI (subscriptions + credit packs). Separate from marketplace payments.
model AiBillingCharge {
  id          String        @id @default(cuid())
  sellerId    String
  seller      SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  kind        String // SUBSCRIPTION | CREDIT_PACK
  planKey     String?
  packKey     String?
  amountCents Int
  provider    String // stripe | test
  providerRef String        @unique
  isTest      Boolean       @default(false)
  status      String        @default("SUCCEEDED") // SUCCEEDED | FAILED | REFUNDED
  createdAt   DateTime      @default(now())

  @@index([createdAt])
  @@index([sellerId, createdAt])
}

model AiCreditPack {
  key        String  @id
  name       String
  credits    Int
  priceCents Int
  active     Boolean @default(true)
}

model AiSpendingLimit {
  sellerId         String        @id
  seller           SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  dailyCreditCap   Int?
  monthlyCreditCap Int?
  warnAtCredits    Int?
}

/// One row per AI operation, including failed and denied ones.
model AiUsageRecord {
  id                 String         @id @default(cuid())
  sellerId           String?
  seller             SellerAccount? @relation(fields: [sellerId], references: [id])
  userId             String?
  planKey            String?
  feature            String
  capability         String
  providerKey        String?
  modelId            String?
  inputTokens        Int?
  outputTokens       Int?
  units              Float? // images, minutes, characters
  unitName           String?
  providerCostMicros BigInt         @default(0)
  creditsCharged     Int            @default(0)
  status             String // SUCCEEDED | FAILED | DENIED
  denyReason         String?
  latencyMs          Int?
  streamId           String?
  productId          String?
  scanId             String?
  isTest             Boolean        @default(false)
  /// The caller's operation key. Unique, so the same operation is never run or billed twice, even when it costs 0 credits.
  idempotencyKey     String?        @unique
  createdAt          DateTime       @default(now())

  creditTxns AiCreditTransaction[]

  @@index([createdAt])
  @@index([sellerId, createdAt])
  @@index([providerKey, createdAt])
  @@index([feature, createdAt])
}

// ───────────────────────── Social, affiliates, ops ─────────────────────────

model Follow {
  followerId String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("sender", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("recipient", fields: [recipientId], references: [id])
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/**
 * A phone registered for push notifications (Expo push token).
 */
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // ios | android
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([userId])
}

model NotificationPreference {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  push       Boolean  @default(true)
  email      Boolean  @default(true)
  /// Notification types the user has turned off entirely, e.g. "stream.live".
  mutedTypes String[] @default([])
  updatedAt  DateTime @updatedAt
}

model Affiliate {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())

  commissions Commission[]
}

model AffiliateCampaign {
  id            String        @id @default(cuid())
  sellerId      String
  seller        SellerAccount @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name          String
  commissionBps Int
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
}

model Commission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  amountCents Int
  status      String    @default("PENDING") // PENDING until order delivered + return window
  createdAt   DateTime  @default(now())

  @@unique([affiliateId, orderId])
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation("reporter", fields: [reporterId], references: [id])
  targetType String // video | comment | stream | chat | user | product
  targetId   String
  reason     String
  status     String    @default("OPEN") // OPEN | ACTIONED | DISMISSED
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

// ───────────────────────── Short-form video ─────────────────────────

enum VideoStatus {
  READY
  REMOVED // by the creator or moderation
}

model Video {
  id            String      @id @default(cuid())
  creatorId     String
  creator       User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption       String      @default("")
  mediaUrl      String
  posterUrl     String?
  mime          String
  bytes         Int
  /// Measured with ffprobe when FFPROBE_PATH is set, otherwise as reported by the uploading app.
  durationSec   Float?
  width         Int?
  height        Int?
  status        VideoStatus @default(READY)
  removedReason String?
  /// Denormalized counters, only ever changed together with the rows they count.
  likeCount     Int         @default(0)
  commentCount  Int         @default(0)
  /// Unique viewers per day (signed-in user or hashed IP), never raw plays.
  viewCount     Int         @default(0)
  createdAt     DateTime    @default(now())

  products VideoProduct[]
  likes    VideoLike[]
  comments VideoComment[]
  views    VideoView[]

  @@index([status, createdAt])
  @@index([creatorId, createdAt])
}

/// Products shown as "shop" cards on a video.
model VideoProduct {
  videoId   String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)

  @@id([videoId, productId])
}

model VideoLike {
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([videoId, userId])
  @@index([userId, createdAt])
}

model VideoComment {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([videoId, createdAt])
}

model VideoView {
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// "u:<userId>" or "ip:<sha256(ip + day)>"
  viewerKey String
  day       String // YYYY-MM-DD (UTC)
  createdAt DateTime @default(now())

  @@id([videoId, viewerKey, day])
}
